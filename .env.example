# Local data directory (database, logs, project folders)
STORYTIME_DATA_DIR=./data

# Zoho Mail IMAP (for reading inbox — not SMTP)
ZOHO_IMAP_HOST=imappro.zoho.com
# Full email address for organization/custom-domain accounts (e.g. you@yourdomain.com)
ZOHO_IMAP_USER=
# Use a Zoho app-specific password if 2FA is enabled (not your login password)
ZOHO_IMAP_PASSWORD=
ZOHO_IMAP_MAILBOX=INBOX

# How often to poll the inbox while the app is running (milliseconds)
INBOX_POLL_INTERVAL_MS=180000

# OpenAI image processing (runs when admin clicks Process on inbox emails)
OPENAI_API_KEY=
# Optional overrides (defaults match the original processing script)
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_TEXT_MODEL=gpt-4o

# Server port
PORT=3200
